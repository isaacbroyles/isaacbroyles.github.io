{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/markdownlint.sh",
            "timeout": 30,
            "statusMessage": "Linting Markdown..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ai-sdlc": {
      "source": {
        "source": "github",
        "repo": "isaacbroyles/ai-sdlc"
      }
    }
  },
  "enabledPlugins": {
    "git-workflow@ai-sdlc": true
  }
}
